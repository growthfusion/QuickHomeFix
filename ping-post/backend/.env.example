PORT=8081

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGIN=http://localhost:5180

# ---------------------------------------------------------------
# ClickHouse -- the ONLY data source. This API never calls
# LeadProsper; the sync service owns that path.
# ---------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=ping_post
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
