# Copy to .env and fill in. Never put real values in THIS file --
# .env is gitignored, .env.example is committed.
#
# NOTE: inline "# comments" after a value are NOT stripped by the
# loader -- they become part of the value. Keep comments on own lines.

# LeadProsper API. Settings -> Developer API Key.
LEADPROSPER_API_KEY=

# live = real API. mock = generated data, no key needed.
LEADPROSPER_MODE=mock

# Must match the LeadProsper account timezone, or daily rollups
# land on the wrong day.
LP_TIMEZONE=America/New_York

# ClickHouse. Full URL incl. scheme AND port.
# ClickHouse Cloud uses https on 8443.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=ping_post
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# First-run backfill window, in days.
BACKFILL_DAYS=180
SYNC_INTERVAL_CRON=*/10 * * * *
